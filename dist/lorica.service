[Unit]
Description=Lorica Reverse Proxy
Documentation=https://github.com/Rwx-G/Lorica
After=network-online.target
Wants=network-online.target

[Service]
# Hot binary upgrade (Story 8.4) requires Type=notify so systemd tracks
# the MainPID handover. On a hot upgrade the OLD supervisor fork+execv's
# the new one; the NEW process sends `sd_notify READY=1\nMAINPID=<newpid>`
# once it is accepting, and systemd reassigns the unit's main PID to it
# while the old process drains and exits 0. See docs/hot-upgrade.md.
#
# REQUIREMENT: Type=notify makes systemd wait for READY=1 at EVERY start,
# not only after an upgrade. The normal (non-upgrade) startup path MUST
# therefore also emit `sd_notify READY=1` once the API + listeners are up,
# in BOTH supervisor and single-process mode, or systemd will time the
# unit out and mark the start failed. The post-upgrade READY alone is not
# sufficient for a cold boot.
Type=notify
# The post-upgrade READY=1 + MAINPID datagram is sent by the NEW process,
# which is not the original MainPID, so NotifyAccess=main would drop it.
# `all` lets any process in the unit's cgroup notify, which is what makes
# the MainPID handover land.
NotifyAccess=all
User=lorica
Group=lorica
ExecStart=/usr/bin/lorica --data-dir /var/lib/lorica
# A clean hot-upgrade exit is code 0: the new process has already taken
# over the MainPID, so with Restart=on-failure systemd must NOT treat that
# exit as a restart trigger (the service is already running under the new
# PID). A
# real crash exits non-zero and still restarts.
Restart=on-failure
RestartSec=5
# SIGTERM goes to the main process so the supervisor can orchestrate the
# worker drain itself; remaining processes are SIGKILLed only after the
# stop timeout. Required for both ordinary shutdown and the hot-upgrade
# drain.
KillMode=mixed
# Must exceed the worker drain window (worker_drain_timeout_s, default 30s)
# with headroom so a legitimate drain is never cut short by systemd.
TimeoutStopSec=90
LimitNOFILE=65536

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lorica

# Security hardening
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# The v1.4.1 certificate filesystem export zone lives by default
# under `/var/lib/lorica/exported-certs`, already covered by the
# ReadWritePaths below. If the operator points
# `cert_export_dir` at a different path, add it here too or the
# exporter will fail with EACCES under `ProtectSystem=strict`.
# The hot-upgrade staging zone `/var/lib/lorica/upgrade` (Story 8.4)
# is created 0700 at runtime by the upgrade endpoint and lives under
# the data dir, so it is already covered by this single entry - no
# extra ReadWritePaths line is needed.
ReadWritePaths=/var/lib/lorica
# CAP_NET_BIND_SERVICE lets the proxy bind privileged ports (80,
# 443) without running as root. CAP_CHOWN is optional and only
# needed when the v1.4.1 cert export feature is configured with
# an owner UID / group GID different from the lorica service
# user - the writer falls back to `ExportOutcome::PermissionsSkipped`
# (documented) rather than failing when the capability is absent,
# but operators who want the `chown` to actually take effect
# should add CAP_CHOWN to both lines.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectKernelTunables=yes
ProtectKernelModules=yes
# Block syslog(2) and /proc/kmsg, /dev/kmsg reads so a post-RCE
# process cannot harvest kernel log lines (KASLR offsets, pointer
# leaks) to chain a local privilege escalation. ProcSubset=pid +
# ProtectProc=invisible already hide /proc/kmsg, but this also
# closes the syslog(2) syscall and /dev/kmsg directly.
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
# v1.5.2 audit M-1 - modern systemd hardening triad.
# Defense-in-depth : none of these are single-points-of-failure
# by themselves, but together they shrink the post-RCE blast
# radius considerably if any part of the proxy ever gets
# compromised.
# Block access to the system clock (Lorica does not need to
# set time ; restricts `settimeofday` / `clock_adjtime` / etc).
ProtectClock=yes
# Block `sethostname` / `setdomainname` (never called by the proxy).
ProtectHostname=yes
# Hide other processes from /proc so a future Lorica RCE cannot
# pivot onto colocated services by reading /proc/*/environ or
# /proc/*/cmdline. `invisible` means non-self processes are
# not visible ; `ProcSubset=pid` hides non-pid /proc entries
# (/proc/kmsg, /proc/kcore, etc) that leak kernel info.
ProtectProc=invisible
ProcSubset=pid
# Socket families the proxy actually uses :
#   AF_INET / AF_INET6 - HTTP listeners + upstream connects
#   AF_UNIX            - worker command channel + fd-passing
#                        via SCM_RIGHTS for privileged ports
# AF_NETLINK stays allowed because the DNS resolver (hickory)
# and some glibc internals use it opportunistically ; keeping
# it here keeps legitimate behaviour working while still
# blocking AF_PACKET / AF_CAN / AF_BLUETOOTH / AF_AX25 / etc.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# Remove any POSIX shm / SysV IPC owned by the lorica user on
# service stop. Lorica itself uses `memfd_create` (process-local,
# GCed when FDs close) not POSIX shm, so this is a no-op on the
# happy path - the defense is against a compromised process
# leaving stale shm segments behind.
RemoveIPC=yes
# Block `/dev/*` raw access. The proxy reads certs + opens
# sockets ; it does not need block devices, raw disks, or
# `/dev/mem`.
PrivateDevices=yes
# Each service gets its own kernel keyring. Prevents a future
# RCE from reading keys another colocated service put in the
# user keyring.
KeyringMode=private
# Additional blacklist on top of `@system-service` :
#   @privileged - CAP_SYS_ADMIN-class syscalls (reboot,
#                 init_module, kexec_load, bpf, etc.).
#   @resources  - setrlimit / prlimit ; systemd applies
#                 LimitNOFILE via prlimit BEFORE exec, the
#                 service itself never needs to call it.
SystemCallFilter=~@privileged @resources
# The `chown` family (chown/fchown/lchown/fchownat) is part of
# @privileged and is therefore killed by the deny list above. The
# v1.4.1 cert-export feature calls `chown` when an owner UID/GID is
# configured (settings `cert_export_owner_uid` / `cert_export_group_gid`),
# so a matching export would send SECCOMP_RET_KILL and take the whole
# proxy down with SIGSYS - a hard crash for an optional feature. This
# trailing rule overrides ONLY the chown family to fail soft with EPERM;
# every other @privileged / @resources syscall still hard-kills. On EPERM
# the exporter falls back to ExportOutcome::PermissionsSkipped
# (lorica-api/src/cert_export.rs), writing the bundle with the configured
# file mode (0640) and owner `lorica`, ownership change skipped. Operators
# who need the `chown` to actually take effect must instead add CAP_CHOWN
# and re-allow @chown (see CapabilityBoundingSet note above).
# (v1.5.13 - fixes the mail.* cert-export re-export SIGSYS incident.)
SystemCallFilter=~@chown:EPERM

[Install]
WantedBy=multi-user.target
